{
  "name": "learn",
  "main": "index.js",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "../dist/learn",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/v0.1.0/*",
      "/index",
      "/index.html",
      "/catalog",
      "/catalog.html",
      "/01-*",
      "/02-*",
      "/03-*",
      "/04-*",
      "/05-*",
      "/06-*",
      "/07-*",
      "/08-*",
      "/09-*",
      "/10-*",
      "/11-*",
      "/12-*",
      "/appendix/*",
      "/supplement/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learn",
      "database_id": "c63cc8b4-ce13-47ec-826f-db31317a6747",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "echo.qus0in.dev",
      "custom_domain": true
    },
    {
      "pattern": "files.qus0in.dev/v0.1.0/*",
      "zone_name": "qus0in.dev"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "learn-files" }]
}

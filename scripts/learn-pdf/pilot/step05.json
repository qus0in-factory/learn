   "# Git Bash·zsh: 자신의 값으로 변경\nACCOUNT=your-account\nREPO=portfolio-web\nBASE=https://github.com\nURL=\"$BASE/$ACCOUNT/$REPO.git\"\ngit remote add origin \"$URL\"\ngit remote -v\ngit push -u origin main",
   "# 주소 오타일 때만\ngit remote set-url \\\norigin \"$URL\"\n# 이름 오타일 때만\ngit remote rename \\\nold origin"
